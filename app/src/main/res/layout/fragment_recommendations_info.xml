<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.RecommendationsInfo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="180dp"
                android:layout_marginTop="20dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true">

            <ImageView
                android:id="@+id/imagePlace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ccsc"/>
        </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textPlaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del lugar turístico"
                android:textSize="25dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                android:paddingTop="16dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esta es una descripción detallada del lugar turístico."
                android:textSize="16sp"
                android:paddingTop="8dp"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:gravity="center" />

            <Button
                android:id="@+id/buttonAction"
                android:layout_width="197dp"
                android:layout_height="60dp"
                android:layout_marginTop="180dp"
                android:backgroundTint="@color/dark_green"
                android:text="@string/preguntar_al_asistente_sobre_este_lugar"
                app:cornerRadius="10dp" />

            <TextView
                android:id="@+id/textLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ir_a_google_maps"
                android:textColor="@android:color/holo_blue_dark"
                android:textSize="16sp"
                android:paddingTop="12dp"
                android:autoLink="web"
                android:clickable="true"
                android:gravity="center" />

        </LinearLayout>

</FrameLayout>
